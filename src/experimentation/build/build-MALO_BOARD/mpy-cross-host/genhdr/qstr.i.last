    if (n_args_min == n_args_max) {
        if (n_args != n_args_min) {



            mp_raise_msg_varg(&mp_type_TypeError,
                (mp_rom_error_text_t)"function takes %d positional arguments but %d were given",
                n_args_min, n_args);

