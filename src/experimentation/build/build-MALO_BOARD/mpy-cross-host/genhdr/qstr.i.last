            size += cnt;
        } else {
            total_cnt += cnt;
            size_t align;
            size_t sz = mp_binary_get_size(fmt_type, *fmt, &align);
            while (cnt--) {

                size = (size + align - 1) & ~(align - 1);
                size += sz;
            }
