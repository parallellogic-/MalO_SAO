static inline void vstr_ins_byte(vstr_t *vstr, size_t byte_pos, byte b) {
    char *s = vstr_ins_blank_bytes(vstr, byte_pos, 1);
    *s = b;
}
static inline void vstr_ins_char(vstr_t *vstr, size_t char_pos, unichar chr) {

