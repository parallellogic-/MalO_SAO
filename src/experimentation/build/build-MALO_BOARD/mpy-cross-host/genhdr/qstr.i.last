size_t mp_parse_num_base(const char *str, size_t len, int *base);
# 30 "../py/parsenumbase.c" 2





size_t mp_parse_num_base(const char *str, size_t len, int *base) {
    const byte *p = (const byte *)str;
    if (len <= 1) {
        goto no_prefix;
    }
    unichar c = *(p++);
    if (c == '0') {
        c = *(p++) | 32;
        int b = *base;
        if (c == 'x' && (b == 0 || b == 16)) {
            *base = 16;
        } else if (c == 'o' && (b == 0 || b == 8)) {
            *base = 8;
        } else if (c == 'b' && (b == 0 || b == 2)) {
            *base = 2;
        } else {
            p -= 2;
            if (b == 0) {
                *base = 1;
            }
        }
    } else {
        p--;
    no_prefix:
        if (*base == 0) {
            *base = 10;
        }
    }
    return p - (const byte *)str;
}
