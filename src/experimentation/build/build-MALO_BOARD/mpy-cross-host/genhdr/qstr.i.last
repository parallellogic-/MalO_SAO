    *s = (char)chr;
}
static inline void vstr_ins_strn(vstr_t *vstr, size_t byte_pos, const char *str, size_t len) {
    char *s = vstr_ins_blank_bytes(vstr, byte_pos, len);
    memcpy(s, str, len);
}
