qstr mp_obj_fun_bc_get_name(const mp_obj_fun_bc_t *fun) {
    const byte *bc = fun->bytecode;


    if (fun->base.type == &mp_type_fun_native || fun->base.type == &mp_type_native_gen_wrap) {
