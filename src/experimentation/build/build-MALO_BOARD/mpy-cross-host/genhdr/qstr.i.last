typedef enum {
    VTYPE_PYOBJ = 0x00 | (0x00),
    VTYPE_BOOL = 0x00 | (0x01),
    VTYPE_INT = 0x00 | (0x02),
    VTYPE_UINT = 0x00 | (0x03),
    VTYPE_PTR = 0x00 | (0x04),
    VTYPE_PTR8 = 0x00 | (0x05),
    VTYPE_PTR16 = 0x00 | (0x06),
    VTYPE_PTR32 = 0x00 | (0x07),

    VTYPE_PTR_NONE = 0x50 | (0x04),

    VTYPE_UNBOUND = 0x60 | (0x00),
    VTYPE_BUILTIN_CAST = 0x70 | (0x00),
} vtype_kind_t;

static qstr vtype_to_qstr(vtype_kind_t vtype) {
    switch (vtype) {
        case VTYPE_PYOBJ:
            return MP_QSTR_object;
        case VTYPE_BOOL:
            return MP_QSTR_bool;
        case VTYPE_INT:
            return MP_QSTR_int;
        case VTYPE_UINT:
            return MP_QSTR_uint;
        case VTYPE_PTR:
            return MP_QSTR_ptr;
        case VTYPE_PTR8:
            return MP_QSTR_ptr8;
        case VTYPE_PTR16:
            return MP_QSTR_ptr16;
        case VTYPE_PTR32:
            return MP_QSTR_ptr32;
        case VTYPE_PTR_NONE:
        default:
            return MP_QSTR_None;
    }
}

