void update_screen()
{
  float rate=millis()*3.1415/2000.0;
  float pos_col=sin(rate)*20+35;//col - where to draw sprite
  float pos_row=cos(rate)*40+70;//row
  //uint8_t* tx_buffer=get_buffer(0);
  uint8_t* tx_buffer=screen.get_frame_buffer();
  for (int i = 0; i < SSD1327_BUFFER_SIZE; i++) {
    if(!is_image_demo) tx_buffer[i]+=0x0202; //animation
    else{
      uint8_t out_col=i%64;//location that is being developed
      uint8_t out_row=i/64;
      float query_col=pos_col-out_col;//where to sample foreground image from
      float query_row=pos_row-out_row;
      uint8_t foreground=0;
      if(query_col>=0 && query_col<64 && query_row>=0 && query_row<128 )
      {
          if((uint8_t)(query_col*2)%2==1)
          {
            uint8_t foreground_upper=test_image[((uint8_t)query_col)+((uint8_t)query_row)*64];
            uint8_t foreground_lower=test_image[((uint8_t)query_col+1)+((uint8_t)query_row)*64];
            foreground=(foreground_upper>>4)|(foreground_lower<<4);
          }else{
            foreground=test_image[((uint8_t)query_col)+((uint8_t)query_row)*64];
          }
      }
      
      uint8_t background=test_image2[i];
      //uint8_t foreground=test_image[i];
      uint8_t upper=((foreground&0xF0)==0?background:foreground)&0xF0;//1 is foreground, 2 is background
      uint8_t lower=((foreground&0x0F)==0?background:foreground)&0x0F;
      tx_buffer[i]=upper|lower;

    }
  }
  //flush();
  //draw();
  screen.flush();
}

int _dma_tx_channel;
uint8_t _tx_buffer[2][SSD1327_BUFFER_SIZE];
bool _display_index=0;//which index is being written to the hardware

const uint8_t frame_command_buffer[]={
                   SSD1327_SETROW,    0, 0x7F,
                   SSD1327_SETCOLUMN, 0, 0x3F};
                   const uint8_t init_128x128[] = {
